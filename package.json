{
  "name": "dsh-iconic-launcher",
  "version": "0.1.0",
  "description": "Custom desktop icon launcher: preset icons plus arbitrary-image to .ico desktop-shortcut creation, with a hosted settings card (host + browser halves)",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./shared": {
      "types": "./shared.d.ts",
      "default": "./shared.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "shared.js",
    "shared.d.ts",
    "ico.js",
    "ico.d.ts",
    "desktop.js",
    "desktop.d.ts",
    "shortcut.ps1",
    "presets/*.js",
    "presets/*.d.ts",
    "presets/assets",
    "presets.js",
    "presets.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "0.1.6"
  },
  "license": "MIT"
}